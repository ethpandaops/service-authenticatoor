 "helm-master-full.yaml": {
  "claims": {
   "aud": [
    "devnet.example.org",
    "other.example.org"
   ],
   "email": "alice@example.org",
   "iss": "https://auth.devnet.example.org",
   "scope": "*.devnet.example.org",
   "sub": "alice@example.org",
   "ttl": 1800
  },
  "config": {
   "AllowedReturnHosts": [
    "*.devnet.example.org"
   ],
   "Audience": [
    "devnet.example.org",
    "other.example.org"
   ],
   "AuthMode": [
    "cfaccess"
   ],
   "CORS": {
    "AllowedOrigins": [
     "*.devnet.example.org"
    ]
   },
   "CloudflareAccess": {
    "AudTag": "0123456789abcdef",
    "JwtHeader": "Cf-Access-Jwt-Assertion",
    "TeamDomain": "ethpandaops.cloudflareaccess.com",
    "UserHeader": "Cf-Access-Authenticated-User-Email",
    "VerifyJWT": true
   },
   "DevMode": false,
   "ExternalURL": "https://auth-ext.devnet.example.org",
   "Issuer": "https://auth.devnet.example.org",
   "Listen": "0.0.0.0:8080",
   "Logging": {
    "Format": "json",
    "Level": "info"
   },
   "Metrics": {
    "Enabled": true,
    "Listen": "0.0.0.0:9090"
   },
   "Providers": [
    {
     "CloudflareAccess": {
      "AudTag": "0123456789abcdef",
      "JwtHeader": "Cf-Access-Jwt-Assertion",
      "TeamDomain": "ethpandaops.cloudflareaccess.com",
      "UserHeader": "Cf-Access-Authenticated-User-Email",
      "VerifyJWT": true
     },
     "Name": "cfaccess",
     "Type": "cloudflare"
    }
   ],
   "ScopePattern": "*.devnet.example.org",
   "Signing": {
    "Mode": "rs256",
    "RS256": {
     "GenerateIfMissing": false,
     "KeyID": "k1",
     "PreviousKeys": [
      {
       "KeyID": "k0",
       "PublicKeyFile": "/etc/authenticatoor/keys-prev/prev-k0.pub.pem"
      }
     ],
     "PrivateKeyFile": "/etc/authenticatoor/keys/active.pem"
    }
   },
   "TokenTTL": 1800000000000,
   "UserHeader": "Cf-Access-Authenticated-User-Email"
  }
 },
